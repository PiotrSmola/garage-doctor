<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "Garage Doctor" : ViewData["Title"] + " — Garage Doctor")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="masthead">
        <div class="shell masthead__inner">
            <a class="masthead__brand" asp-controller="Home" asp-action="Index">Garage Doctor <span>· NHTSA defect data</span></a>
            <nav class="masthead__nav">
                <a asp-controller="Home" asp-action="Index">Find a vehicle</a>
                <a href="/search">Search reports</a>
                <a href="/components">Components</a>
                <a asp-controller="Makes" asp-action="Index">Makes</a>
                <a href="/about">About the data</a>
            </nav>
        </div>
    </header>

    <main>
        <div class="shell">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="shell">
            Built on public domain complaint and recall files from the
            <a href="https://static.nhtsa.gov/odi/ffdd/" rel="noreferrer">NHTSA Office of Defects Investigation</a>.
            Complaints are filed voluntarily and are not a failure rate.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
